{
  "name": "quartz-gui",
  "productName": "QuartzControl",
  "desktopName": "quartzcontrol.desktop",
  "version": "1.0.0-beta.1",
  "description": "Desktop GUI for managing Quartz 5 sites: config, plugins, content source, builds and the local dev server.",
  "main": "./out/main/index.js",
  "author": "Holger Borker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "node scripts/postinstall.mjs",
    "smoke": "node scripts/smoke.mjs",
    "docs:variables": "node scripts/variable-docs.mjs",
    "check:semver": "node scripts/check-semver.mjs",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "template:example": "node scripts/build-example-template.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "fetch:git": "node scripts/fetch-git.mjs",
    "icon": "node scripts/build-icon.mjs",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:flatpak": "npm run build && electron-builder --linux flatpak"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@uiw/react-codemirror": "^4.25.11",
    "basic-ftp": "^6.2.0",
    "i18next": "^24.0.5",
    "lucide-react": "^1.33.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.3",
    "react-router-dom": "^7.18.3",
    "ssh2-sftp-client": "^12.1.1",
    "tree-kill": "^1.2.2",
    "typescript": "^5.7.2",
    "yaml": "^2.6.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "ctx7": "^0.5.8",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "npm": "11.17.0",
    "playwright-core": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
